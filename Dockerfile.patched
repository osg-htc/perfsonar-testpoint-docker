# syntax=docker/dockerfile:1.7
#
# Uses a standard ARG + FROM. Workflow will pass BASE_IMAGE=local/perfsonar-testpoint:<meta>
# Cache busting via PATCH_REV.

ARG BASE_IMAGE
ARG PATCH_REV=1
FROM ${BASE_IMAGE}

ARG PATCH_REV
ENV PATCH_REV=${PATCH_REV}

# OSG additions (see osg/):
#  - osg-exporter-acl.conf: restricts /node_exporter, /perfsonar_host_exporter and
#    /metrics to loopback plus the allow-list in /etc/apache2/osg/exporter-allow.conf
#    (sites can bind-mount their own list over that file). It lives in conf-enabled,
#    not in default-ssl.conf, so it also applies on hosts that mount their own
#    default-ssl.conf.
#  - osg-instance-secrets: per-container pScheduler DB password and snakeoil key,
#    replacing the ones generated at build time (identical in every pulled image).
COPY osg/osg-exporter-acl.conf /etc/apache2/conf-available/osg-exporter-acl.conf
COPY osg/exporter-allow.conf /etc/apache2/osg/exporter-allow.conf
COPY osg/osg-instance-secrets /usr/local/sbin/osg-instance-secrets
COPY osg/osg-instance-secrets.service /etc/systemd/system/osg-instance-secrets.service

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    set -eux; \
    echo "Patch revision: ${PATCH_REV}"; \
    if ! command -v apache2ctl >/dev/null 2>&1; then \
      apt-get update; \
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends apache2; \
    fi; \
    a2enmod proxy proxy_http || true; \
    CONF=/etc/apache2/sites-available/default-ssl.conf; \
    sed -i '/# BEGIN OSG restrictions/,/# END OSG restrictions/d' "$CONF"; \
    a2enconf osg-exporter-acl; \
    chmod 0755 /usr/local/sbin/osg-instance-secrets; \
    chmod 0644 /etc/apache2/osg/exporter-allow.conf /etc/systemd/system/osg-instance-secrets.service; \
    mkdir -p /etc/systemd/system/multi-user.target.wants; \
    ln -sf /etc/systemd/system/osg-instance-secrets.service /etc/systemd/system/multi-user.target.wants/osg-instance-secrets.service; \
    echo '--- BEFORE ports.conf ---'; \
    cat /etc/apache2/ports.conf || true; \
    { \
      echo '# Patched to disable plain HTTP (port 80)'; \
      echo '<IfModule ssl_module>'; \
      echo '    Listen 443'; \
      echo '</IfModule>'; \
      echo '<IfModule mod_gnutls.c>'; \
      echo '    Listen 443'; \
      echo '</IfModule>'; \
    } > /etc/apache2/ports.conf.tmp; \
    mv /etc/apache2/ports.conf.tmp /etc/apache2/ports.conf; \
    echo '--- AFTER ports.conf ---'; \
    cat /etc/apache2/ports.conf; \
    if grep -R --line-number 'Listen 80' /etc/apache2 2>/dev/null; then \
      echo 'ERROR: Residual Listen 80 found after rewrite' >&2; \
      exit 1; \
    fi; \
    a2dissite 000-default >/dev/null 2>&1 || true; \
    rm -f /etc/apache2/sites-enabled/000-default.conf || true; \
    rm -f /etc/apache2/sites-available/000-default.conf || true; \
    a2ensite default-ssl >/dev/null 2>&1 || true; \
    grep -q '^ServerName ' /etc/apache2/apache2.conf || echo 'ServerName localhost' >> /etc/apache2/apache2.conf; \
    apache2ctl -t; \
    echo '--- ACTIVE LISTENERS (grep) ---'; \
    grep -R "^[[:space:]]*Listen" /etc/apache2 || true
