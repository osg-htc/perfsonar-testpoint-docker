#!/bin/bash
#
# osg-instance-secrets: replace secrets that are baked into the public image.
#
# The image is built once and pulled by every site, so anything generated at
# build time is the same everywhere and can be read by anyone who pulls it:
#   - the pScheduler PostgreSQL password (/etc/pscheduler/database/*)
#   - the Apache snakeoil TLS key (/etc/ssl/private/ssl-cert-snakeoil.key)
#
# This runs once per container instance (systemd oneshot, before pScheduler and
# Apache start). A recreated container starts again from the image's database
# and files, so it gets new secrets again; a restarted container keeps its own.
# Nothing secret is written to the journal.

set -euo pipefail

STATE_DIR=/var/lib/osg-perfsonar
MARKER="$STATE_DIR/instance-secrets.done"
DB_DIR=/etc/pscheduler/database
ROLE=pscheduler

log() { echo "osg-instance-secrets: $*"; }

if [ -e "$MARKER" ]; then
    log "already done for this container instance ($(cat "$MARKER"))"
    exit 0
fi
mkdir -p "$STATE_DIR"

# --- Snakeoil TLS key -------------------------------------------------------
# Used until a real certificate (e.g. Let's Encrypt) is configured.
if command -v make-ssl-cert >/dev/null 2>&1; then
    make-ssl-cert generate-default-snakeoil --force-overwrite
    log "new snakeoil key and certificate generated"
else
    log "WARNING: make-ssl-cert not found; snakeoil key not replaced"
fi

# --- pScheduler database password ------------------------------------------
if [ -s "$DB_DIR/database-password" ]; then
    # Wait for PostgreSQL (the unit is ordered after it, but the cluster may
    # still be starting).
    for _ in $(seq 1 60); do
        pg_isready -q && break
        sleep 1
    done
    pg_isready -q || { log "ERROR: PostgreSQL not ready; password not rotated"; exit 1; }

    umask 077
    NEW=$(python3 -c 'import secrets, string; a = string.ascii_letters + string.digits; print("".join(secrets.choice(a) for _ in range(48)))')

    # Change the role's password first; the statement goes in on stdin so the
    # password never appears in a process listing.
    printf "ALTER ROLE %s WITH PASSWORD '%s';\n" "$ROLE" "$NEW" \
        | runuser -u postgres -- psql -q -v ON_ERROR_STOP=1 -d postgres >/dev/null

    # Then rewrite the three files pScheduler reads, keeping their formats.
    printf '%s\n' "$NEW" > "$DB_DIR/database-password.new"
    sed -E "s/(password=)[^ ]*/\1${NEW}/" "$DB_DIR/database-dsn" > "$DB_DIR/database-dsn.new"
    awk -F: -v OFS=: -v pw="$NEW" '{ $5 = pw; print }' "$DB_DIR/pgpassfile" > "$DB_DIR/pgpassfile.new"
    for f in database-password database-dsn pgpassfile; do
        chown --reference="$DB_DIR/$f" "$DB_DIR/$f.new"
        chmod --reference="$DB_DIR/$f" "$DB_DIR/$f.new"
        mv -f "$DB_DIR/$f.new" "$DB_DIR/$f"
    done
    unset NEW
    log "pScheduler database password rotated"
else
    log "WARNING: $DB_DIR/database-password missing; password not rotated"
fi

date -u +%Y-%m-%dT%H:%M:%SZ > "$MARKER"
