[Unit]
Description=OSG: per-instance secrets (pScheduler DB password, snakeoil TLS key)
After=postgresql.service postgresql@14-main.service
Before=apache2.service pscheduler-ticker.service pscheduler-scheduler.service pscheduler-runner.service pscheduler-archiver.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/osg-instance-secrets

[Install]
WantedBy=multi-user.target
